# ---------------------------------------------------------------------------
# BRIX Digital Payment — environment configuration
# Copy to `.env` (or `.env.local`) and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Existing BRIX backend origin. The mobile app is a *client* of this backend;
# it does not run its own server.
EXPO_PUBLIC_BRIX_API_BASE_URL=https://dp.brixgroup.ir

# Central gateway script used by the web app (window.BRIX_API || '/api.php').
# All routed calls are issued as: <base>/api.php?route=<encoded-route>
EXPO_PUBLIC_BRIX_API_GATEWAY=/api.php

# Default currency used before a local reference rate is resolved.
EXPO_PUBLIC_BRIX_DEFAULT_CURRENCY=AED

# Default UI language (en | fa | ar | tr | ru | hi).
EXPO_PUBLIC_BRIX_DEFAULT_LANGUAGE=en

# Set to "true" only for local debugging against a non-TLS backend.
# MUST be false for release builds: the app refuses cleartext HTTP when false.
EXPO_PUBLIC_BRIX_ALLOW_CLEARTEXT=false
