{
  "expo": {
    "name": "BRIX Digital Payment",
    "slug": "brix-digital-payment",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "brixdp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "primaryColor": "#0b1220",
    "backgroundColor": "#08101d",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08101d"
    },
    "ios": {
      "bundleIdentifier": "ir.brixgroup.dp",
      "buildNumber": "1",
      "supportsTablet": false,
      "requireFullScreen": false,
      "usesAppleSignIn": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "BRIX Digital Payment uses the camera to scan BRIX payment QR codes.",
        "NSFaceIDUsageDescription": "BRIX Digital Payment uses Face ID to protect access to your wallet and payments.",
        "NSPhotoLibraryUsageDescription": "BRIX Digital Payment allows attaching a payment proof image for funding requests.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "ir.brixgroup.dp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08101d"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "BRIX Digital Payment uses the camera to scan BRIX payment QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BRIX Digital Payment uses Face ID to protect access to your wallet and payments."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#caa65a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#08101d"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      },
      "brix": {
        "apiBaseUrl": "https://dp.brixgroup.ir",
        "apiGatewayPath": "/api.php",
        "webOrigin": "https://dp.brixgroup.ir"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
